# Temporary empty probe for the live app's build/version BEFORE private import.
# Only this probe shares live app/Workshop; permanent pztest stays independent.
# Stop both normal projects' control services while this probe owns the ports.
COMPOSE_PROJECT_NAME=pzlive-versioncheck
PZ_SERVER_NAME=pztest
PZ_BIND_ADDRESS=0.0.0.0
PZ_HOST_PORT=16261
PZ_HOST_UDP_PORT=16262
PZ_HEAP=2g
PZ_SECRETS_DIR=./secrets/versioncheck
PZ_APP_VOLUME=pzlive_app
PZ_WORKSHOP_VOLUME=pzlive_workshop
