COMPOSE_PROJECT_NAME=pzdev
PZ_SERVER_NAME=pztest
PZ_BIND_ADDRESS=127.0.0.1
PZ_HOST_PORT=16261
PZ_HOST_UDP_PORT=16262
# Empty disposable server. Live uses the separate .env.live.example (8g).
PZ_HEAP=2g
PZ_READY_TIMEOUT=1200
# Optional explicit existing volumes for handoff/testing; leave blank normally.
PZ_APP_VOLUME=
PZ_WORKSHOP_VOLUME=
# The legacy default remains compatible; Debian profiles use separate secrets.
PZ_SECRETS_DIR=./secrets
PZ_ADVERTISE_LAN=
PZ_ADVERTISE_VPN=
PZ_ADVERTISE_PUBLIC=
PZ_DISCORD_GUILD_ID=
PZ_DISCORD_RESTART_ROLE=Zomboid
